# Server 配置
PORT=3001

# ==================== Sui 配置 ====================
# Sui RPC 地址
SUI_RPC_URL=https://fullnode.testnet.sui.io

# Sui 私钥（Base64 格式，不含 0x 前缀）
# 可以从 Sui CLI 导出：sui keytool export --key-identity <address>
SUI_PRIVATE_KEY=your_base64_private_key_here

# Sui 合约配置（从 web_surge_token/src/networkConfig.ts 复制）
SUI_PACKAGE_ID=0xa85bf1df86ac7eccb503f51a5b40f1fab94ef0788f6d9fe605a04c032ff07d78
SUI_BRIDGE_STATE=0x73d5c13821558903002f37f4e267cb814f5a606a749d7dbb1ad7ec823b628b9b
SUI_STATE=0x31358d198147da50db32eda2562951d53973a0c0ad5ed738e9b17d88b213d790

# ==================== BSC 配置 ====================
# BSC RPC 地址（测试网）
BSC_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545

# BSC 私钥（十六进制格式，不含 0x 前缀）
BSC_PRIVATE_KEY=your_bsc_private_key_here

# BSC SurgeBridgeExecutor 合约地址
BSC_EXECUTOR_ADDRESS=0xYourBSCExecutorAddress
