    # Server Config
    PORT=3001
    WORMHOLE_API_BASE=https://api.testnet.wormholescan.io/api/v1/operations

    # BSC Configuration (Testnet)
    BSC_RPC=https://data-seed-prebsc-1-s1.binance.org:8545
    # 部署合约时得到的 Executor 地址
    SURGE_EXECUTOR_BSC=0xAE63Ad273B8de69771dcE5C8494921C0542f4641
    # Relayer 私钥 (带0x)
    BSC_PRIVATE_KEY=你的BSC私钥

    # Sui Configuration (Testnet)
    SUI_RPC=https://fullnode.testnet.sui.io:443
    # 你的 Move Package ID
    SURGE_PACKAGE_ID=0x...
    # 你的合约 Shared Object ID (State)
    SURGE_STATE_ID=0x...
    # Wormhole 在 Sui Testnet 的 State ID (固定值)
    WORMHOLE_STATE_ID=0x31358d198147da50db32eda2562951d53973a0c0ad5ed738e9b17d88b213d790
    # Relayer 私钥 (Base64 格式)
    SUI_PRIVATE_KEY=你的Sui私钥Base64